#include <lsf/lsf.dtsi>
#include <lsf/dt-bindings/services/vad.h>

/ {
	chosen {
		lsf,dsp-firmware = &dsp_firmware;
	};
};

&flash0 {
	partitions {
		dsp_firmware: partition@100000 {
			label = "dsp_firmware";
			reg = <0x100000 DT_SIZE_M(1)>;
		};
	};
};

&lsf_vad {
	status = "okay";
	channel = <VAD_CH_LEFT>;
	amp-l = <2000>;
	amp-h = <6000>;
	minlen = <3>;
};
