#include <lsf/lsf.dtsi>

/ {
	chosen {
		lsf,dsp-firmware = &dsp_firmware;
		lsf,dsp-wasm-app = &wasm_app;
	};
};

&flash0 {
	partitions {
		dsp_firmware: partition@100000 {
			label = "dsp_firmware";
			reg = <0x100000 DT_SIZE_M(1)>;
		};

		wasm_app: partition@200000 {
			label = "wasm_app";
			reg = <0x200000 DT_SIZE_M(1)>;
		};

		thinker_model: partition@300000 {
			label = "thinker_model";
			reg = <0x300000 DT_SIZE_M(3)>;
		};

		thinker_test_data: partition@600000 {
			label = "thinker_test_data";
			reg = <0x600000 DT_SIZE_M(1)>;
		};
	};
};

&lsf_thinker {
	status = "okay";
};

&lsf_wasm {
	status = "okay";
};
