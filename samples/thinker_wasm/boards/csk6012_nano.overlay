#include <lsf/lsf.dtsi>

/delete-node/ &storage_partition;

/ {
	chosen {
		lsf,dsp-firmware = &dsp_firmware;
		lsf,dsp-wasm-app = &wasm_app;
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&storage_partition>;
			// automount;
			// no-format;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&flash0 {
	partitions {
		dsp_firmware: partition@100000 {
			label = "dsp_firmware";
			reg = <0x100000 DT_SIZE_M(1)>;
		};

		wasm_app: partition@200000 {
			label = "wasm_app";
			reg = <0x200000 DT_SIZE_M(1)>;
		};

		thinker_model: partition@300000 {
			label = "thinker_model";
			reg = <0x300000 DT_SIZE_M(3)>;
		};

		storage_partition: partition@600000 {
			label = "storage";
			reg = <0x600000 DT_SIZE_M(1)>;
		};
	};
};

&lsf_thinker {
	status = "okay";
};

&lsf_wasm {
	status = "okay";
};
