#include <lsf/lsf.dtsi>

/ {
	chosen {
		lsf,dsp-firmware = &dsp_firmware;
	};
};

&flash0 {
	partitions {
		dsp_firmware: partition@100000 {
			label = "dsp_firmware";
			reg = <0x100000 DT_SIZE_M(1)>;
		};

		test_audio: partition@200000 {
			label = "test_audio";
			reg = <0x200000 453350>;
		};

		test_aac_audio: partition@300000 {
			label = "test_aac_audio";
			reg = <0x300000 102276>;
		};
	};
};

&lsf_audio {
	status = "okay";
};
